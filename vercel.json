{
  "redirects": [
    {
      "source": "/assets/pisirsem-logo.svg",
      "destination": "/assets/pisirsem-logo-official.png",
      "permanent": false
    },
    {
      "source": "/assets/pisirsem-logo.jpg",
      "destination": "/assets/pisirsem-logo-official.png",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/pisirsem-logo-official.png",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
